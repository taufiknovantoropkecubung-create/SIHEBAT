/**
 * BACKEND GOOGLE APPS SCRIPT - SIHEBAT (DENGAN INTEGRASI JAM & BUKTI FOTO)
 * Salin seluruh kode ini ke Apps Script editor di Google Sheet Anda.
 */

function doGet(e) {
  return ContentService.createTextOutput(JSON.stringify({ status: "success", message: "SIHEBAT API Ready" }))
    .setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName("Data_Pembiasaan");
    
    if (!sheet) {
      sheet = ss.insertSheet("Data_Pembiasaan");
      sheet.appendRow([
        "Timestamp", "Tanggal", "Nama Siswa", "Bangun Pagi (Jam)", "Beribadah (Jam/Foto)", 
        "Berolahraga (Jam/Foto)", "Makan Sehat (Jam/Foto)", "Gemar Belajar (Jam/Foto)", 
        "Bermasyarakat (Jam/Foto)", "Tidur Cepat (Jam)", "Catatan Refleksi", "Persetujuan Orang Tua"
      ]);
    }
    
    var data = JSON.parse(e.postData.contents);
    var habits = data.habits || {};
    var times = data.times || {};
    var photos = data.photos || {};
    
    sheet.appendRow([
      new Date(),
      data.date || "",
      data.studentName || "Siswa",
      habits.bangunPagi ? ("YA (" + (times.bangunPagi || "-") + ")") : "TIDAK",
      habits.beribadah ? ("YA (" + (times.beribadah || "-") + " | " + (photos.beribadah ? "Ada Foto" : "-") + ")") : "TIDAK",
      habits.berolahraga ? ("YA (" + (times.berolahraga || "-") + " | " + (photos.berolahraga ? "Ada Foto" : "-") + ")") : "TIDAK",
      habits.makanSehat ? ("YA (" + (times.makanSehat || "-") + " | " + (photos.makanSehat ? "Ada Foto" : "-") + ")") : "TIDAK",
      habits.gemarBelajar ? ("YA (" + (times.gemarBelajar || "-") + " | " + (photos.gemarBelajar ? "Ada Foto" : "-") + ")") : "TIDAK",
      habits.bermasyarakat ? ("YA (" + (times.bermasyarakat || "-") + " | " + (photos.bermasyarakat ? "Ada Foto" : "-") + ")") : "TIDAK",
      habits.tidurCepat ? ("YA (" + (times.tidurCepat || "-") + ")") : "TIDAK",
      data.notes || "",
      data.parentApproved ? "YA" : "TIDAK"
    ]);
    
    return ContentService.createTextOutput(JSON.stringify({ status: "success", message: "Data tersimpan" }))
      .setMimeType(ContentService.MimeType.JSON);
  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({ status: "error", message: err.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}
